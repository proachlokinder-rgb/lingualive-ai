# LinguaLive AI Backend Configuration

# Server Settings
APP_NAME=LinguaLive AI Backend
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# CORS Configuration (comma-separated origins, or * for development)
ALLOWED_ORIGINS=*

# Translation Providers (default: google via deep-translator)
# Supported: google, libre, openai, azure
DEFAULT_TRANSLATION_PROVIDER=google

# Optional Cloud API Keys (Leave blank to use free built-in Google engine)
OPENAI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
GOOGLE_APPLICATION_CREDENTIALS=

# WebRTC STUN / TURN Server Configuration for Phone-to-Phone Audio
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# Audio & Signalling Limits
MAX_ROOM_CAPACITY=2
ROOM_INACTIVE_TIMEOUT_SECONDS=3600
MAX_AUDIO_UPLOAD_MB=15
